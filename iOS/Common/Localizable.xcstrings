            "value": "设置充电模式"
          }
        }
      }
    },
    "Switches your charger to another charging mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换充电器的充电模式。"
          }
        }
      }
    },
    "Get Charger Power": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取充电功率"
          }
        }
      }
    },
    "Returns how many watts your charger is delivering right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回充电器当前输出的功率（瓦）。"
          }
        }
      }
    },
    "%@ W across %lld ports": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 个端口共输出 %1$@ W"
          }
        }
      }
    },
    "Power follows each device. Best for everyday use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按每台设备的需求分配功率，适合日常使用。"
          }
        }
      }
    },
    "Gentle output on every port. Cool and quiet for the night.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各端口温和输出，夜间充电凉爽安静。"
          }
        }
      }
    },
    "C4 behaves like a USB-A port for fans and lamps. Ports reconnect when you switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "C4 模拟 USB-A 端口，为风扇、台灯等供电。切换时端口会断电重连。"
          }
        }
      }
    },
    "Maximum efficiency for a quick top-up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以最高效率快速补充电量。"
          }
        }
      }
    },
    "Only C1 delivers power, up to 140 W. The other ports turn off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅 C1 输出，最高 140 W。其他端口将关闭。"
          }
        }
      }
    },
    "Power First": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功率优先"
          }
        }
      }
    },
    "Cool First": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度优先"
          }
