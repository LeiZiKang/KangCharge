{
  "sourceLanguage": "en",
  "strings": {
    "Kang Charge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kang Charge"
          }
        }
      }
    },
    "Monitor and control your CANDYSIGN charger.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监测和控制你的 CANDYSIGN 充电器。"
          }
        }
      }
    },
    "MCP server URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 服务器地址"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        }
      }
    },
    "Nickname (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称（可选）"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "The address stays on this iPhone, in the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址保存在这台 iPhone 的钥匙串中。"
          }
        }
      }
    },
    "Where do I find this?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在哪里可以找到？"
          }
        }
      }
    },
    "In the CANDYSIGN app, open your charger's MCP settings and copy the server URL. It looks like https://mcp.thecandysign.com/…/sse.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 CANDYSIGN App 中打开充电器的 MCP 设置，复制服务器地址。地址类似于 https://mcp.thecandysign.com/…/sse。"
          }
        }
      }
    },
    "Try with Sample Data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验示例数据"
          }
        }
      }
    },
    "Kang Charge is an independent app and is not affiliated with CANDYSIGN.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kang Charge 是独立应用，与 CANDYSIGN 无关联。"
